# Slack — from your app at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token        # OAuth & Permissions > Bot User OAuth Token
SLACK_APP_TOKEN=xapp-your-app-token        # Settings > Socket Mode > app-level token

# Anthropic auth — choose ONE path:

# (A) PERSONAL / PROTOTYPE — bills against your Claude Max plan.
#     Generate this once with:  claude setup-token
#     Leave ANTHROPIC_API_KEY unset, or it will silently take precedence.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-your-oauth-token

# (B) DEPLOYED / SHARED BOT — pay-as-you-go API billing. Required if anyone
#     other than you will use the bot. Uncomment this and delete (A) above.
# ANTHROPIC_API_KEY=sk-ant-api03-your-key
