# SuperMe — ONE .env for every surface. Copy to `.env` (gitignored) and fill it in.
# The Python services load it from superme_agent/paths.py and web/bff/_env.py; Vite reads
# the VITE_* vars from this same file through `envDir`.
#
# Every value below except the auth token has a working default. Set only what you change.

# ─── Auth (required) ───────────────────────────────────────────────────────────
# Your Claude plan's OAuth token, from `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=            # pay-as-you-go instead; SHADOWS the OAuth token if set

# ─── Core daemon ───────────────────────────────────────────────────────────────
SUPERME_DAEMON_HOST=127.0.0.1
SUPERME_DAEMON_PORT=8787
# Seconds the daemon waits for a tool approval before denying.
SUPERME_APPROVAL_TIMEOUT=180

# ─── Web BFF ───────────────────────────────────────────────────────────────────
SUPERME_BFF_HOST=127.0.0.1
SUPERME_BFF_PORT=8000
# How the BFF reaches the daemon.
SUPERME_DAEMON_URL=http://127.0.0.1:8787

# ─── Frontend · Vite (VITE_* reach the browser — never put a secret here) ──────
VITE_PORT=5173
# Where Vite proxies /api (the BFF).
VITE_BFF_TARGET=http://127.0.0.1:8000

# ─── Storage locations ─────────────────────────────────────────────────────────
# The knowledge repo holding every connected repo's knowledge home.
# SUPERME_KNOWLEDGE_REPO=       # default: <repo>/superme-knowledge
# Where the Claude CLI keeps session transcripts.
# CLAUDE_PROJECTS_DIR=          # default: ~/.claude/projects
# Item worktrees live outside the repo, where `git clean -fdx` cannot reach them.
# SUPERME_WORKTREES_HOME=       # default: ~/.superme/worktrees

# ─── Run behavior ──────────────────────────────────────────────────────────────
# The interpreter SuperMe runs under. The daemon sets this for the agent's own shell;
# set it yourself only when running a script by hand outside your environment.
# SUPERME_PY=
# A run silent for this long is treated as stalled and cancelled.
# SUPERME_STALL_SECONDS=1200
# SUPERME_STALL_POLL=120        # how often the watchdog looks
