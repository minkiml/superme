# SuperMe — ONE .env for all surfaces. Copy to `.env` (gitignored) and fill in.
# Three spaces share this single file: Shared, Backend, Frontend (Vite).
# Python services load this via superme_agent/runtime/config.py (and web/bff/_env.py);
# Vite reads the VITE_* vars from here via `envDir` pointed at the repo root.

# ─── Shared ────────────────────────────────────────────────────────────────────
# Auth for the Claude Agent SDK — use your Claude plan (OAuth) OR an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=            # pay-as-you-go; SHADOWS the OAuth token if set

# ─── Backend · Core daemon ──────────────────────────────────────────────────────
SUPERME_DAEMON_HOST=127.0.0.1
SUPERME_DAEMON_PORT=8787
# Seconds the daemon waits for a tool approval before denying.
SUPERME_APPROVAL_TIMEOUT=180
# Global knowledge home (default: <repo>/superme-global-knowledge).
# SUPERME_KNOWLEDGE_GLOBAL=
# Where the Claude SDK stores session transcripts (default: ~/.claude/projects).
# CLAUDE_PROJECTS_DIR=

# ─── Backend · Web BFF ──────────────────────────────────────────────────────────
SUPERME_BFF_HOST=127.0.0.1
SUPERME_BFF_PORT=8000
# How the BFF reaches the daemon.
SUPERME_DAEMON_URL=http://127.0.0.1:8787

# ─── Backend · Slack surface (optional) ─────────────────────────────────────────
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=

# ─── Frontend · Vite (VITE_* are exposed to the browser) ────────────────────────
VITE_PORT=5173
# Where Vite proxies /api (the BFF).
VITE_BFF_TARGET=http://127.0.0.1:8000
