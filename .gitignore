# Secrets — .env.example is the tracked template.
.env
.env.*
!.env.example

# macOS Finder metadata
.DS_Store

# Local runtime state: the stores the daemon owns, plus hand-made backups.
.slash_commands.json
.dev.db
.system.db
.dev.db.*
.system.db.*

# Private knowledge home — per-user, never in the app repo.
superme-knowledge/

# Local repo registry: the spine writes this machine's paths into it.
# Seeded from config/repos.example.yaml on first start.
/superme_agent/config/repos.yaml
# Snapshots of it, taken before each write and once per boot. Local state, real paths.
/superme_agent/config/repos-backups/

# Per-user operational cells. The engine's own cell ships with the pool and the README,
# because every guest runs that same engine.
superme_agent/local-harness/*
!superme_agent/local-harness/asset/
!superme_agent/local-harness/global/
!superme_agent/local-harness/README.md
# Which assets a cell has adopted is that machine's curation, and the runtime rewrites it.
superme_agent/local-harness/*/*/constitution/.assets

# Per-worktree vet-environment state, written by the vet skill's boot script.
.vet-env.json
.vet-env.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Editors
.idea/
.vscode/

# The developer's own notes and drafts.
TODO.md
general_docs/

# scripts/ ships its suites and gate tooling; what stays local is machine-bound or spent.
/scripts/__pycache__/
/scripts/comment_pass/
/scripts/migrate_phase_rename.py
/scripts/pg_drive.py
/scripts/compaction_bakeoff.py
/scripts/probe_context_floor.py

# Benchmark output: measurements, not source.
scripts/bench-result/
/scripts/probe_fork.py
/scripts/probe_compaction.py
/scripts/probe_curve.py
/scripts/probe_ttl.py
/scripts/probe_thin_fork.py
