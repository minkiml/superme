# Secrets — .env.example is the tracked template.
.env
.env.*
!.env.example

# macOS Finder metadata
.DS_Store

# Local runtime state: the stores the daemon owns, plus hand-made backups.
.slash_commands.json
.dev.db
.system.db
.dev.db.*
.system.db.*

# Private knowledge home — per-user, never in the app repo.
superme-knowledge/

# Local repo registry: the spine writes this machine's paths into it.
# Seeded from config/repos.example.yaml on first start.
/superme_agent/config/repos.yaml

# Per-user operational cells. Only the shared asset pool and this dir's README ship.
superme_agent/local-harness/*
!superme_agent/local-harness/asset/
!superme_agent/local-harness/README.md

# Per-worktree vet-environment state, written by the vet skill's boot script.
.vet-env.json
.vet-env.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Editors
.idea/
.vscode/

